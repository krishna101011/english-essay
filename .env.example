DATABASE_URL=sqlite:///./app.db
SESSION_SECRET_KEY=generate-a-unique-32-plus-character-secret
ENCRYPTION_KEY=generate-with-fernet-generate-key
APP_ENV=development

# Development uses memory://. Production requires a shared Redis URL so all
# Uvicorn workers enforce the same limits; set this through your host's secret
# manager, never commit a real password here.
RATE_LIMIT_STORAGE_URI=memory://

# Request timeouts in seconds. The app saves the essay and shows a retry
# message if a provider or local grammar check times out.
AI_TIMEOUT_SECONDS=30
LANGUAGE_TOOL_TIMEOUT_SECONDS=15

# Keep false for all hosted deployments. Enable only on a trusted self-hosted
# deployment that intentionally permits public HTTPS custom provider endpoints.
ALLOW_CUSTOM_AI_ENDPOINTS=false

# Leave these blank for local dev: emails are logged to the console instead
# of sent (see app/email/sender.py). Fill them in for a real deployment.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@example.com
