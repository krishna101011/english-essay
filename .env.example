DATABASE_URL=sqlite:///./app.db
SESSION_SECRET_KEY=change-me
ENCRYPTION_KEY=generate-with-fernet-generate-key
APP_ENV=development

# Leave these blank for local dev: emails are logged to the console instead
# of sent (see app/email/sender.py). Fill them in for a real deployment.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@example.com
